# Copy to .env and fill tokens. NEVER commit .env (see .gitignore).
#
# Defense: active V6 registry, Unified Attention, cache-backed Protocol A.
# scripts/demo_vsl400.ps1 verifies the locked registry and checkpoint.
# No credentials are required for the offline defense demo.
# Optimized inference is evidence-only on the UI; do not override the registry.

# --- Credentials ---
HF_TOKEN=
KAGGLE_API_TOKEN=
# Optional: gloss_llm mode only
GEMINI_API_KEY=
GEMINI_ALIGN_MODEL=gemini-2.5-flash-lite

# --- Device ---
# Canonical E1 (MS-STA matrix) requires a working CUDA torch build.
# Trainer fail-closes if device_expected=cuda and CUDA is unavailable (no silent CPU).
CUDA_VISIBLE_DEVICES=0

# Operator-only D4 candidate: load locked B4 while defense_ready=false / status=NO-GO.
# Prefer registry.d4_candidate_allowed=true after E2 PASS; env is an extra override.
# ALLOW_MS_STA_CANDIDATE=1

# --- RGB backbone id (VSL400 SlowFast) ---
RGB_BACKEND=slowfast_r50
